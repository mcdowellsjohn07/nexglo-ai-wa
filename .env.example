# ---------------------------------------------------------------------------
# NexgloTV WhatsApp AI Agent — environment configuration
# Copy to .env and fill in. Never commit your real .env.
# ---------------------------------------------------------------------------

# --- Meta WhatsApp Cloud API ------------------------------------------------
# System User or temporary access token for your WhatsApp Business app.
# Meta App Dashboard -> WhatsApp -> API Setup -> Temporary access token,
# or generate a permanent System User token in Business Settings.
WHATSAPP_TOKEN=EAAG_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The Phone Number ID (NOT the phone number itself).
# Meta App Dashboard -> WhatsApp -> API Setup -> "Phone number ID".
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# A random string YOU choose. You type the same value into the Meta webhook
# config; Meta echoes it back on the GET verification handshake.
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string

# Your App Secret, used to verify the X-Hub-Signature-256 on every webhook.
# Meta App Dashboard -> App Settings -> Basic -> "App secret" (click Show).
WHATSAPP_APP_SECRET=00000000000000000000000000000000

# Graph API version to call. v21.0 is a safe recent default.
GRAPH_API_VERSION=v21.0

# Dry-run: while the token / phone number id above are empty or still these
# placeholders, nothing is sent to Meta. Replies are stored in a local outbox
# (GET /dev/outbox) and scripts/send_webhook.py prints them. Set to 1 to force
# dry-run even with real credentials (e.g. on a staging server).
# WHATSAPP_DRY_RUN=1

# --- LLM (OpenRouter or NVIDIA NIM, OpenAI-compatible) ---------------------
# Option A (Recommended Free): Free OpenRouter key from https://openrouter.ai
# Default model: NVIDIA Nemotron 3.5 Lightning (100% Free tier)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_TIMEOUT_SECONDS=25
OPENROUTER_MAX_OUTPUT_TOKENS=500

# Option B: Direct NVIDIA NIM from https://build.nvidia.com
# Provides 1,000 free API credits. Key starts with "nvapi-".
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning

# --- Business profile -------------------------------------------------------
BUSINESS_NAME=NexgloTV
# One line the LLM uses to describe you ("You are the WhatsApp assistant for
# <BUSINESS_NAME>, <BUSINESS_DESCRIPTION>").
BUSINESS_DESCRIPTION=Internet-based television and entertainment service in Sierra Leone
BUSINESS_PHONE=
# Drives which days/hours can be booked (see WEEKLY_HOURS in app/catalog.py).
BUSINESS_TIMEZONE=Africa/Freetown
CURRENCY_LABEL=Le

# --- Staff console (/admin) ---------------------------------------------------
# Bearer token for the human-handoff API. Empty = /admin answers 503.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Local audio transcription (optional) -----------------------------------
# Model size: tiny | base | small | medium | large-v3. "base" is a good balance.
WHISPER_MODEL=base

# --- CRM (Lark Base — RECOMMENDED for NexgloTV) ------------------------------
# CRM_PROVIDER=lark_base | google_sheets | mock
# lark_base uses the Lark CLI login on this machine. The "NexgloTV CRM" Base
# (18 tables) is auto-created on first start; packages are auto-seeded.
CRM_PROVIDER=lark_base
LARK_BASE_TOKEN=E8jObNOAeaZqUHsyxRHjR9VcpBg
# LARK_BASE_TOKEN=              # empty = auto-find/create the Base

# --- Google Sheets CRM (alternative) -----------------------------------------
#GOOGLE_SHEET_ID=REPLACE_WITH_SPREADSHEET_ID
#GOOGLE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_SECURE_JSON_OR_ENCODED_SECRET

# --- Media ------------------------------------------------------------------
# Price card media URL or WhatsApp media ID
PRICE_CARD_MEDIA_URL=
PRICE_CARD_MEDIA_ID=

# --- Payment config ---------------------------------------------------------
DISCOUNT_PERCENT=20
DISCOUNT_ACTIVE=true

# --- Optional: override the SQLite path -------------------------------------
# DB_PATH=data/nexglotv.sqlite

# --- Server -----------------------------------------------------------------
# BotKeep expects the app to bind to 0.0.0.0 and the assigned port
SERVER_PORT=8000
PUBLIC_BASE_URL=https://YOUR_BOTKEEP_HOSTNAME
